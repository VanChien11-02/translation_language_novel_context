# Lấy Server name từ ô Server name khi kết nối SSMS.
# Ví dụ: localhost, .\SQLEXPRESS, DESKTOP-XXX\SQLEXPRESS
SQL_SERVER=localhost
SQL_DATABASE=ContextTranslateDB
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Local development only! Ở production dùng chứng chỉ tin cậy.
SQL_TRUST_SERVER_CERTIFICATE=yes

# Để trống 2 biến dưới đây nếu dùng Windows Authentication.
SQL_USER=
SQL_PASSWORD=

# Chỉ cần khi thực sự gọi AI. Không gửi hoặc commit file .env!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
